# PokeManager Configuration
# Copy this file to .env and fill in your values

# ── Required — Supabase database ──────────────────────────────────────────────
# Create a project at supabase.com, then paste the values from Project Settings → API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Required — JWT auth secret ────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-secret-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Required — Discord bot ────────────────────────────────────────────────────
# Get a token at https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token

# ── Optional — eBay API (enables listing & sale detection) ────────────────────
# Get App ID, Dev ID, and Cert ID from developer.ebay.com → My Account → Application Keys
EBAY_APP_ID=
EBAY_DEV_ID=
EBAY_CERT_ID=

# Run generate_ebay_token.py once to obtain this. Valid for 18 months.
EBAY_REFRESH_TOKEN=

# Business policy IDs — find yours by running:
#   python -c "import asyncio, lister_ebay_api; asyncio.run(lister_ebay_api.print_policies())"
# Or navigate to: ebay.co.uk → Account → Business policies
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=

# Optional — AI listing descriptions (for Gym Leader users)
# Get a key at https://ai.google.dev/
GEMINI_API_KEY=

# Bot owner Supabase user ID (for bot→Supabase sync)
BOT_OWNER_USER_ID=

# ── Stripe billing (enables subscriptions) ────────────────────────────────────
# Get these from stripe.com → Developers → API keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Price IDs for subscription tiers (create prices in Stripe Dashboard)
STRIPE_PRICE_GYM_LEADER=
STRIPE_PRICE_CHAMPION=

# ── Web URLs ──────────────────────────────────────────────────────────────────
# SITE_URL: Used for OAuth callbacks and redirects (e.g., https://pokemanager.example.com)
SITE_URL=http://localhost:8000

# APP_URL: Used for billing portal redirects (typically same as SITE_URL)
APP_URL=http://localhost:8000

# ── Web server ────────────────────────────────────────────────────────────────
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_RELOAD=false

# ── Pricing defaults (can be overridden per-user in Settings) ────────────────
EBAY_FEE_RATE=0.1235
KOREAN_PRICE_MULTIPLIER=0.7
EBAY_MIN_PRICE_GBP=0.99
AUTO_SYNC_EBAY_PRICES=true

# ── Inventory ─────────────────────────────────────────────────────────────────
EXCEL_FILE=inventory.xlsx
COMMAND_PREFIX=!

# ── Price updater ─────────────────────────────────────────────────────────────
# Discord channel ID where the update summary embed is posted (0 = disabled)
PRICE_UPDATE_CHANNEL_ID=0
UPDATE_INTERVAL_HOURS=12

# ── Dev / testing ─────────────────────────────────────────────────────────────
# Set to your Discord server ID for instant slash-command sync during development.
# Leave at 0 (or omit) to use global sync instead (takes up to 1 hour to propagate).
TEST_GUILD_ID=0

# Set to true only when actively developing web/ files — auto-restarts the server on change.
# Keep false during normal use to avoid interrupting requests.
WEB_RELOAD=false

# ── Backups / audit ───────────────────────────────────────────────────────────
BACKUP_DIR=backups
BACKUP_RETENTION_COUNT=50
AUDIT_LOG_DIR=logs
